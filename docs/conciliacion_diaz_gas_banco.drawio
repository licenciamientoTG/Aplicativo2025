<mxGraphModel dx="1450" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1150" math="0" shadow="0">
  <root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="t" value="Díaz Gas · Del turno al depósito conciliado" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#20364A;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1050" height="55" as="geometry"/></mxCell>
    <mxCell id="scheduler" value="El sistema revisa&#xa;coincidencias cada 10 minutos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F5;strokeColor=#60798D;" vertex="1" parent="1"><mxGeometry x="50" y="145" width="220" height="70" as="geometry"/></mxCell>
    <mxCell id="lock" value="¿Ya hay otra revisión&#xa;automática en curso?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#E3B341;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="245" height="100" as="geometry"/></mxCell>
    <mxCell id="skip" value="Espera a la siguiente revisión" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#AAB8C2;" vertex="1" parent="1"><mxGeometry x="680" y="140" width="210" height="70" as="geometry"/></mxCell>
    <mxCell id="window" value="Revisa los depósitos&#xa;del mes en curso&#xa;y recupera los del mes anterior al inicio de mes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FF;strokeColor=#188AE2;" vertex="1" parent="1"><mxGeometry x="330" y="290" width="245" height="95" as="geometry"/></mxCell>
    <mxCell id="read" value="Reúne la información necesaria&#xa;Depósitos en efectivo aún no conciliados&#xa;Turnos de ControlGas y papeletas REGIO relacionadas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FF;strokeColor=#188AE2;" vertex="1" parent="1"><mxGeometry x="280" y="435" width="345" height="110" as="geometry"/></mxCell>
    <mxCell id="auto" value="Para cada turno de Díaz Gas en MN o Morralla&#xa;Compara el depósito con el monto real recibido según REGIO&#xa;La diferencia debe ser de $1 o menos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF2E6;strokeColor=#198754;" vertex="1" parent="1"><mxGeometry x="280" y="600" width="345" height="95" as="geometry"/></mxCell>
    <mxCell id="candidate" value="¿Hay un solo depósito que coincide con el turno?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#E3B341;" vertex="1" parent="1"><mxGeometry x="330" y="750" width="245" height="100" as="geometry"/></mxCell>
    <mxCell id="guard" value="Antes de confirmar, verifica que el turno y el depósito no se hayan usado, que no estén en tránsito y que el período siga abierto. Luego los registra juntos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#8B69B3;" vertex="1" parent="1"><mxGeometry x="260" y="910" width="385" height="115" as="geometry"/></mxCell>
    <mxCell id="manual" value="Deja el caso sin confirmar&#xa;Falta una relación REGIO, no hay coincidencia o más de un depósito parece posible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#E3B341;" vertex="1" parent="1"><mxGeometry x="720" y="750" width="330" height="95" as="geometry"/></mxCell>
    <mxCell id="ui" value="El equipo abre el tablero&#xa;elige estación, mes y tipo de efectivo&#xa;y revisa turnos y depósitos pendientes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FF;strokeColor=#188AE2;" vertex="1" parent="1"><mxGeometry x="720" y="435" width="330" height="95" as="geometry"/></mxCell>
    <mxCell id="manualgroup" value="Cuando hace falta, el equipo elige el turno o los turnos y el depósito. Si los datos son válidos y están disponibles, el sistema los registra juntos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF2E6;strokeColor=#198754;" vertex="1" parent="1"><mxGeometry x="1120" y="590" width="280" height="120" as="geometry"/></mxCell>
    <mxCell id="result" value="El tablero muestra lo conciliado&#xa;y lo que sigue pendiente.&#xa;También muestra si la última revisión automática terminó bien o requiere atención." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#8B69B3;" vertex="1" parent="1"><mxGeometry x="720" y="910" width="330" height="105" as="geometry"/></mxCell>
    <mxCell id="n" value="La revisión automática cubre MN y Morralla. Los dólares se revisan por separado en el tablero y no los concilia esta tarea automática. Los depósitos dudosos y los tránsitos pendientes requieren revisión del equipo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D7E0E7;fontColor=#34495E;" vertex="1" parent="1"><mxGeometry x="50" y="1060" width="1350" height="60" as="geometry"/></mxCell>
