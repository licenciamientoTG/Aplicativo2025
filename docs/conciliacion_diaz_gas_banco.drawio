    <mxCell id="e7" value="Único" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="candidate" target="guard"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e8" value="Ninguno o ambiguo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="candidate" target="manual"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="manual" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ui" target="manualgroup"><mxGeometry relative="1" as="geometry"/></mxCell>
