    <mxCell id="title" value="Conciliación de efectivo · Díaz Gas&#xa;Cómo se reúnen y revisan los datos" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#20364A;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="700" height="65" as="geometry"/></mxCell>
    <mxCell id="scope" value="Esta vista explica únicamente el proceso de Díaz Gas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#E3B341;fontColor=#76530B;" vertex="1" parent="1"><mxGeometry x="820" y="34" width="700" height="45" as="geometry"/></mxCell>
    <mxCell id="regio" value="REGIO envía el reporte diario&#xa;Incluye las papeletas de depósitos de las estaciones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FF;strokeColor=#188AE2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="45" y="145" width="250" height="100" as="geometry"/></mxCell>
    <mxCell id="cronA" value="Cada día, el sistema revisa el correo&#xa;y registra las papeletas recibidas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF2E6;strokeColor=#198754;fontSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="145" width="255" height="100" as="geometry"/></mxCell>
    <mxCell id="analiticos" value="Papeletas REGIO disponibles&#xa;El sistema las compara con los turnos de ControlGas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#8B69B3;fontSize=14;" vertex="1" parent="1"><mxGeometry x="690" y="130" width="290" height="130" as="geometry"/></mxCell>
    <mxCell id="cg" value="ControlGas registra los turnos&#xa;de venta y sus importes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F5;strokeColor=#60798D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="45" y="355" width="250" height="100" as="geometry"/></mxCell>
    <mxCell id="bank" value="El banco informa los depósitos&#xa;recibidos en las cuentas de Díaz Gas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FF;strokeColor=#188AE2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="340" width="255" height="130" as="geometry"/></mxCell>
    <mxCell id="cronB" value="Cada 10 minutos, el sistema&#xa;busca coincidencias entre turnos&#xa;y depósitos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF2E6;strokeColor=#198754;fontSize=14;" vertex="1" parent="1"><mxGeometry x="690" y="355" width="290" height="100" as="geometry"/></mxCell>
