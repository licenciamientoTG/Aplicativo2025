<mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1500" math="0" shadow="0">
  <root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="t" value="Díaz Gas · Cómo se revisan los reportes REGIO" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#20364A;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1000" height="55" as="geometry"/></mxCell>
    <mxCell id="start" value="Cada día, el sistema revisa&#xa;el correo de reportes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF2E6;strokeColor=#198754;fontSize=15;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="330" height="65" as="geometry"/></mxCell>
    <mxCell id="mail" value="Busca correos con reportes&#xa;y revisa sus archivos adjuntos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FF;strokeColor=#188AE2;" vertex="1" parent="1"><mxGeometry x="400" y="220" width="330" height="75" as="geometry"/></mxCell>
    <mxCell id="filter" value="¿Es el reporte de depósitos REGIO de Díaz Gas?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#E3B341;" vertex="1" parent="1"><mxGeometry x="425" y="335" width="280" height="95" as="geometry"/></mxCell>
    <mxCell id="ignore" value="Si no corresponde, el archivo no se incorpora" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#AAB8C2;" vertex="1" parent="1"><mxGeometry x="800" y="345" width="270" height="65" as="geometry"/></mxCell>
    <mxCell id="dedupe" value="¿Ya se había recibido&#xa;este mismo reporte?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#E3B341;" vertex="1" parent="1"><mxGeometry x="425" y="485" width="280" height="95" as="geometry"/></mxCell>
    <mxCell id="dup" value="Evita cargarlo dos veces&#xa;(se puede reprocesar bajo solicitud)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#AAB8C2;" vertex="1" parent="1"><mxGeometry x="800" y="500" width="270" height="70" as="geometry"/></mxCell>
    <mxCell id="parse" value="Lee cada papeleta&#xa;Identifica estación, fecha, remesa y montos declarados y recibidos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FF;strokeColor=#188AE2;" vertex="1" parent="1"><mxGeometry x="360" y="635" width="410" height="100" as="geometry"/></mxCell>
    <mxCell id="err" value="Si una papeleta está incompleta o repetida, la deja señalada para revisión" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C0392B;" vertex="1" parent="1"><mxGeometry x="820" y="650" width="290" height="75" as="geometry"/></mxCell>
    <mxCell id="persist" value="Guarda el reporte y sus papeletas&#xa;para que el equipo pueda consultarlos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#8B69B3;" vertex="1" parent="1"><mxGeometry x="400" y="795" width="330" height="100" as="geometry"/></mxCell>
    <mxCell id="cg" value="Busca los turnos de ControlGas&#xa;de esa estación y fechas cercanas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F5;strokeColor=#60798D;" vertex="1" parent="1"><mxGeometry x="400" y="950" width="330" height="85" as="geometry"/></mxCell>
    <mxCell id="match" value="Compara los montos de cada papeleta con los turnos&#xa;Solo propone una asociación cuando encuentra una coincidencia clara y no usada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FF;strokeColor=#188AE2;" vertex="1" parent="1"><mxGeometry x="350" y="1090" width="430" height="120" as="geometry"/></mxCell>
    <mxCell id="linked" value="Papeleta relacionada con su turno&#xa;La relación queda disponible para las siguientes revisiones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#8B69B3;" vertex="1" parent="1"><mxGeometry x="355" y="1280" width="420" height="85" as="geometry"/></mxCell>
    <mxCell id="review" value="Si hay varias opciones o faltan datos, el caso queda pendiente para que el equipo corrija la información o elija la asociación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#E3B341;" vertex="1" parent="1"><mxGeometry x="810" y="1105" width="300" height="105" as="geometry"/></mxCell>
    <mxCell id="end" value="El tablero muestra turnos y papeletas asociadas&#xa;Esta relación ayuda a revisar depósitos; no confirma por sí sola una conciliación con el banco." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF2E6;strokeColor=#198754;" vertex="1" parent="1"><mxGeometry x="390" y="1410" width="360" height="70" as="geometry"/></mxCell>
