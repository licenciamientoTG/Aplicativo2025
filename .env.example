# Copiar como .env en el servidor. Nunca versionar el archivo .env real.

# Correo de Analíticos REGIO
EFC_CONC_ANALITICOS_MAIL_USER=correo@dominio.com
EFC_CONC_ANALITICOS_MAIL_PASSWORD=coloca_aqui_la_contrasena
EFC_CONC_ANALITICOS_IMAP_HOST=imap.gmail.com
EFC_CONC_ANALITICOS_IMAP_PORT=993
EFC_CONC_ANALITICOS_IMAP_FOLDER=INBOX

# SQL Server TG: conexión por IP, usuario y contraseña
EFC_CONC_DB_DRIVER=ODBC Driver 17 for SQL Server
EFC_CONC_DB_HOST=192.168.0.6
EFC_CONC_DB_PORT=1433
EFC_CONC_DB_NAME=TG
EFC_CONC_DB_USER=usuario_sqlserver
EFC_CONC_DB_PASSWORD=coloca_aqui_la_contrasena
EFC_CONC_DB_TRUST_CERTIFICATE=yes
